# URL of the Spring backend. On a phone/emulator use your computer's LAN IP, e.g. http://192.168.1.20:8080
# (Android emulator can also use http://10.0.2.2:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google Maps JavaScript API key for the operator city map (web only). Leave empty to use the built-in OpenStreetMap map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Google Maps map id; defaults to Google's DEMO_MAP_ID
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
