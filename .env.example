DB_URL=jdbc:postgresql://your-database-host:5432/postgres?sslmode=require
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password
# PayPal sandbox credentials: supplied only to the backend at runtime.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

TENDER_IMAGE_TAG=demo
BACKEND_PORT=8080
FRONTEND_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:8080
# Public browser key: enable Maps JavaScript API and Places, and allow the demo origin.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
APP_OPERATOR_RESET_ENABLED=true
