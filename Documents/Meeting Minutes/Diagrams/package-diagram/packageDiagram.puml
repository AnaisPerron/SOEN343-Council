@startuml TenderPackageDiagram
title Tender - Phase II Package Diagram

skinparam packageStyle folder
skinparam backgroundColor #FFFFFF
left to right direction

package "tender" {

  package "ui" {
    class LoginScreen
    class RegisterScreen
    class MenuScreen
    class OrderScreen
    class RestaurantPanel
    class EventConsole
  }

  package "service" {
    class RegistrationService
    class LoginService
    class OrderService
    class RestaurantService
  }

  package "model" {
    class Profile
    class CustomerProfile
    class RestaurantProfile
    class CourierProfile
    class Operator
    class Restaurant
    class MenuItem
    class Order
    class OrderLine
    class OrderStatus
  }

  package "repository" {
    class ProfileRepository
    class RestaurantRepository
    class MenuItemRepository
    class OrderRepository
  }
}

package "database" {
  class PostgreSQL
}

ui ..> service : <<use>>
service ..> model : <<use>>
service ..> repository : <<use>>
repository ..> model : <<use>>
repository ..> database : <<use>>

@enduml