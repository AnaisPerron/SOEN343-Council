@startuml
actor ":Customer" as Customer
participant ":System" as System
participant ":Billing System" as Billing
actor ":Restaurant" as Restaurant

== UC-ORD-01: Browse Menus ==
Customer -> System: requestRestaurantSelection()
activate System
System -> System: checkRestaurantStatuses()
System --> Customer: displayOpenRestaurantsAndMenus()
deactivate System

== UC-ORD-02: Place Order ==
Customer -> System: submitOrder(restaurantId, lineItems, paymentChoice)
activate System
System -> System: validateRestaurantAndItemAvailability()
System -> Billing: processPayment(paymentChoice)
activate Billing
Billing --> System: confirmPaymentApproval()
deactivate Billing
System -> System: createOrder(status: "placed", eventId)
System -> Restaurant: sendOrderToRestaurnatQueue(orderId)
System --> Customer: outputSuccessConfirmation(orderId, status: "placed", timestamp)
deactivate System

== Order Cancellation Check (UC-ORD-05) ==
alt Customer Cancels Order
    Customer -> System: requestCancellation(orderId)
    activate System
    System -> System: checkOrderStatus(status: "placed")
    System -> System: transitionToCancelled(orderId)
    System --> Customer: outputCancellationConfirmation()
    deactivate System

else Order Proceeds to Restaurant Queue
    activate Restaurant

    alt UC-ORD-03: Restaurant Rejects Order
        Restaurant -> System: submitDecision(orderId, decision: "Reject", rejectionReason)
        activate System
        System -> System: verifyPermissionsAndTransitionToRejected(orderId)
        System --> Restaurant: updateQueueDisplayAndNotification()
        deactivate System
        System --> Customer: notifyOrderRejected(orderId, rejectionReason)

    else UC-ORD-03 & UC-ORD-04: Restaurant Accepts & Prepares Order
        Restaurant -> System: submitDecision(orderId, decision: "Accept")
        activate System
        System -> System: verifyPermissionsAndTransitionToAccepted(orderId)
        System --> Restaurant: updateQueueDisplayAndNotification()
        deactivate System
        System --> Customer: notifyOrderAccepted(orderId)

        == UC-ORD-04: Update Order Status (Preparing) ==
        Restaurant -> System: submitNextStateCommand(orderId, targetState: "preparing")
        activate System
        System -> System: updateStatusToPreparing(orderId)
        System --> Customer: updateTrackingView(status: "preparing")
        deactivate System

        == UC-ORD-04: Update Order Status (Ready) ==
        Restaurant -> System: submitNextStateCommand(orderId, targetState: "ready")
        activate System
        System -> System: updateStatusToReady(orderId)
        System --> Restaurant: logUpdatedOrderStateInConsole(orderId)
        deactivate System
        System --> Customer: notifyOrderReady(orderId)
    end
    deactivate Restaurant
end
@enduml